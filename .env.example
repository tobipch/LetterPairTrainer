# Neon / Vercel Postgres
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# iron-session secret (min 32 chars)
SESSION_SECRET=change-me-to-a-random-32-char-string-here

# Vercel Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Seed user credentials (used by scripts/seed-user.ts)
SEED_USERNAME=admin
SEED_PASSWORD=changeme123
